<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The WebView and the K1000 Wi-Fi request -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android 17+: the box is on the local network (asked at run time) -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- The page's haptics (navigator.vibrate) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The phone-mic spectrum (asked only when the box's page asks for the microphone) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- The QR scanner (asked when Scan is tapped) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.wifi" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.K1000"
        android:usesCleartextTraffic="false"
        tools:targetApi="37">

        <!-- The WebView only ever shows the box: no Safe Browsing lookups, no WebView metrics. -->
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <!-- Portrait for now (D-007 update: a landscape EQ layout comes later, in the page).
             Config changes are handled in place: recreating the activity would drop the
             K1000 link and reload the page mid-show. That includes Bold text
             (fontWeightAdjustment, API 31), grammatical gender (API 34) and a wallpaper or theme
             colour change (assetsPaths: runtime resource overlays). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|colorMode|grammaticalGender|assetsPaths|touchscreen|mcc|mnc"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The launcher shortcuts' only way in (long-press the K1000 icon: v2, v1, Diagnostics).
             Not exported: no other app can switch the page or reload it mid-show. Shortcuts are
             started as K1000 itself, so a non-exported target works. MainActivity ignores those
             actions when they name it directly (ShellRules.SHORTCUT_ALIAS). -->
        <activity-alias
            android:name=".Shortcut"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- ZXing Android Embedded's own scanner activity needs AndroidX: the app scans inside
             MainActivity with the library's camera view instead. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            tools:node="remove" />
    </application>
</manifest>
