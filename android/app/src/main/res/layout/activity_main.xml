<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later
     One screen: the box's page in a WebView, with native panels on top when the page cannot be
     shown (joining, not connected, setup). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    tools:ignore="MergeRootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Joining / Not connected to K1000 / errors -->
    <LinearLayout
        android:id="@+id/status_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/k1000_black"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/k1000_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/status_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:maxWidth="420dp"
            android:textColor="@color/k1000_dim"
            android:textSize="16sp" />

        <Button
            android:id="@+id/status_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="200dp"
            android:minHeight="56dp"
            android:text="@string/status_retry"
            android:textSize="18sp" />

        <Button
            android:id="@+id/status_wifi"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/status_wifi" />

        <Button
            android:id="@+id/status_change"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/status_change" />
    </LinearLayout>

    <!-- First run / change K1000 Wi-Fi -->
    <ScrollView
        android:id="@+id/setup_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/k1000_black"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/setup_title"
                android:textColor="@color/k1000_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/setup_text"
                android:textColor="@color/k1000_dim"
                android:textSize="16sp" />

            <Button
                android:id="@+id/setup_scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="64dp"
                android:text="@string/setup_scan"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/setup_or_type"
                android:textColor="@color/k1000_dim"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/setup_ssid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autofillHints=""
                android:hint="@string/setup_ssid_hint"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:minHeight="48dp"
                android:textColor="@color/k1000_text" />

            <EditText
                android:id="@+id/setup_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autofillHints=""
                android:fontFamily="monospace"
                android:hint="@string/setup_password_hint"
                android:importantForAutofill="no"
                android:inputType="textVisiblePassword|textNoSuggestions"
                android:minHeight="48dp"
                android:textColor="@color/k1000_text" />

            <TextView
                android:id="@+id/setup_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/k1000_error"
                android:textSize="16sp"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/setup_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/setup_system"
                android:textColor="@color/k1000_dim" />

            <Button
                android:id="@+id/setup_join"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="56dp"
                android:text="@string/setup_join"
                android:textSize="18sp" />

            <Button
                android:id="@+id/setup_cancel"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/setup_cancel" />

            <Button
                android:id="@+id/setup_about"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="48dp"
                android:text="@string/setup_about" />
        </LinearLayout>
    </ScrollView>

    <!-- The QR scanner (ZXing Android Embedded's camera view) -->
    <FrameLayout
        android:id="@+id/scan_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/k1000_black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.journeyapps.barcodescanner.DecoratedBarcodeView
            android:id="@+id/scan_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/scan_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:minHeight="48dp"
            android:text="@string/scan_cancel" />
    </FrameLayout>

    <!-- About & licences (GPL-3.0-or-later, the source, ZXing's Apache-2.0): assets/licenses -->
    <LinearLayout
        android:id="@+id/about_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/k1000_black"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/about_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:minHeight="48dp"
            android:text="@string/about_close" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/about_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/k1000_dim"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>

    <!-- The app's own menu: opened by Back at the page's top level ("Back again: hide K1000").
         The top of the screen only, so the page's footer (MUTE) stays visible and touchable.
         Switching the page or the Wi-Fi needs a hold; a tap only says so. -->
    <LinearLayout
        android:id="@+id/menu_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/k1000_panel"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/menu_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/k1000_amber"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/menu_hide"
                style="@style/K1000.MenuButton"
                android:text="@string/menu_hide" />

            <Button
                android:id="@+id/menu_diag"
                style="@style/K1000.MenuButton"
                android:text="@string/menu_diag" />

            <Button
                android:id="@+id/menu_reload"
                style="@style/K1000.MenuButton"
                android:text="@string/menu_reload" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/menu_ui"
                style="@style/K1000.MenuButton"
                android:text="@string/menu_ui_v1" />

            <Button
                android:id="@+id/menu_wifi"
                style="@style/K1000.MenuButton"
                android:text="@string/menu_wifi" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_hint"
            android:textColor="@color/k1000_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Diagnostics (the menu, a launcher shortcut, or the page's {t:"diag", show:true}). The
         bottom 128dp stay the page's: its footer (MUTE) is never covered. -->
    <LinearLayout
        android:id="@+id/diag_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="128dp"
        android:background="@color/k1000_panel"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/diag_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/k1000_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/diag_haptics"
                style="@style/K1000.MenuButton"
                android:text="@string/diag_haptics" />

            <Button
                android:id="@+id/diag_edge"
                style="@style/K1000.MenuButton"
                android:text="@string/diag_edge" />

            <Button
                android:id="@+id/diag_copy"
                style="@style/K1000.MenuButton"
                android:text="@string/diag_copy" />

            <Button
                android:id="@+id/diag_close"
                style="@style/K1000.MenuButton"
                android:text="@string/diag_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/diag_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:textColor="@color/k1000_amber"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/diag_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/k1000_dim"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>

    <!-- Edge test (Diagnostics): two amber bands excluded from the Back gesture, as the page's
         slide areas are. Not clickable itself: the page stays usable around the bands. -->
    <FrameLayout
        android:id="@+id/edge_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/edge_left"
            android:layout_width="32dp"
            android:layout_height="200dp"
            android:layout_gravity="start|center_vertical"
            android:background="@color/k1000_band"
            android:clickable="true"
            android:focusable="false" />

        <View
            android:id="@+id/edge_right"
            android:layout_width="32dp"
            android:layout_height="200dp"
            android:layout_gravity="end|center_vertical"
            android:background="@color/k1000_band"
            android:clickable="true"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="48dp"
            android:layout_marginTop="24dp"
            android:background="@color/k1000_panel"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/edge_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/k1000_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/edge_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:minHeight="48dp"
                android:text="@string/edge_end" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
