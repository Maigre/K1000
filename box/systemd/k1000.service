# SPDX-License-Identifier: GPL-3.0-or-later
# K1000 control service (knobs, screen, state, persistence). Installed by box/install.sh.
#
# Why it looks like this:
# - Wants/After camilladsp: start the engine first, but k1000 copes with the engine being down
#   (it shows ENGINE DOWN and re-applies when the websocket comes back), so no Requires=.
# - The "+" prefix runs the ExecStartPre as root: unbinding the Linux framebuffer console from the
#   ZynScreen (vtcon "frame buffer device") needs root, and without it the console's text and
#   cursor draw over the UI. The loop matches by name so it survives vtcon renumbering.
#   At boot the panel may register only AFTER k1000 started (then this unbind finds nothing):
#   k1000-console.service (wanted below, never waited for) unbinds it once the panel exists.
#   This ExecStartPre still covers every later k1000 restart.
# - User k1000 with groups i2c (MCP23017 knobs), gpio (interrupt lines), video (/dev/fb0),
#   audio (ALSA probing) instead of root.
# - PYTHONUNBUFFERED: log lines reach the journal immediately (journalctl -u k1000 -f).
#   PYTHONDONTWRITEBYTECODE: /opt/k1000 is root-owned and read-only for k1000.
# - Restart=always + StartLimitIntervalSec=0: a crash never leaves the box without its control
#   surface; audio itself does not depend on this service.
# - CAP_NET_BIND_SERVICE (ambient, and the only capability in the bounding set): the phone page
#   listens on 443 (HTTPS) and the captive portal on 80, as the k1000 user (D-007). The "+"
#   ExecStartPre is not affected by CapabilityBoundingSet (it runs with full privileges).
# - LimitNOFILE=4096 (default 1024): the phone servers' sockets come out of the same pool as the
#   state file, the engine websocket and the knob bus. The AP fence already caps the page's ports
#   (16 connections per phone, 64 in all); this is the margin behind it.
# - RuntimeDirectory=k1000 (/run/k1000, k1000's own, removed whenever this service stops) and
#   Wants= k1000-laptop.path: SETUP > Laptop access creates /run/k1000/laptop-open there and the
#   root watcher opens the fence for the Friday tune's laptop (docs/06-phone.md §11). k1000 itself
#   gains nothing: the bounding set above leaves it no way to root (no sudo, no nft). k1000
#   stopping removes the directory, so the opening closes with it.

[Unit]
Description=K1000 control service (knobs, screen, state)
Documentation=file:///opt/k1000/README.md
Wants=camilladsp.service k1000-console.service k1000-laptop.path
After=camilladsp.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=k1000
Group=k1000
SupplementaryGroups=i2c gpio video audio
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
WorkingDirectory=/opt/k1000
Environment=PYTHONPATH=/opt/k1000 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStartPre=+/bin/sh -c 'for v in /sys/class/vtconsole/vtcon*; do if grep -q "frame buffer" "$$v/name"; then echo 0 > "$$v/bind"; fi; done; exit 0'
ExecStart=/usr/bin/python3 -m k1000
Restart=always
RestartSec=1
TimeoutStopSec=5
LimitNOFILE=4096
RuntimeDirectory=k1000
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
