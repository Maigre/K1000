# SPDX-License-Identifier: GPL-3.0-or-later
# K1000 bench switch "usb-rt": real-time priority for the deferred USB work (D-023 point 3).
# Installed and enabled by box/install.sh --usb-rt-on; stopped, disabled and removed by
# --usb-rt-off and by --cpu-off. Off by default. Its effect on the delay steps is NOT measured yet.
#
# Why: the M4's USB completions are soft-interrupt work on core 0, run just after the xHCI's
# interrupt. When that work runs over 2 ms, or another task is waiting for the core, the kernel
# hands the rest to ksoftirqd/0, a thread at normal priority (SCHED_OTHER): then it waits behind
# whatever normal task holds core 0. A wait of about 3 ms is enough for the playback queue to grow
# to its maximum and stay there (D-023).
#
# What it does when started, and so at every boot (/opt/k1000/tools/k1000-cpu.py usb-rt apply):
# - ksoftirqd/0 at SCHED_FIFO 51: before every normal task on core 0, and just above the
#   interrupt threads (FIFO 50, the kernel's priority for them; on core 0 unless usb-cpu0 moves
#   them: the SD card's and the Wi-Fi's shared one among them). The USB stream has a deadline of
#   a few milliseconds; an SD-card write or a Wi-Fi frame finished a millisecond later costs
#   nothing audible. Far below migration/0 (99). The engine's threads (FIFO 10) are on cores 2-3
#   and never meet it.
# - The xHCI's interrupt thread too, at FIFO 51, if the kernel runs one: only with threadirqs on
#   the kernel command line, which K1000 does not set (docs/manual/02-installation.md §6).
#
# What could go wrong: ksoftirqd/0 runs ALL the deferred soft-interrupt work of core 0, not only
# USB (network receive, block completions, timers, RCU). A flood of it holds core 0 for as long as
# it lasts. Nothing caps a FIFO 51 thread against the interrupt threads at FIFO 50: since Linux
# 6.12, sched_rt_runtime_us throttles real-time threads only on a kernel with RT group scheduling,
# and Raspberry Pi's is built without it (read in the source, not yet on the box). Normal tasks
# keep 50 ms of each second of core 0 through the kernel's fair server. So with usb-rt alone, the
# SD card's and the Wi-Fi's interrupt threads (on core 0 unless usb-cpu0 moves them) wait while
# other soft-interrupt work keeps core 0 busy (Ethernet receive during a deploy): SD and Wi-Fi I/O
# stop for that time. With usb-cpu0 on, the SD card's, the Wi-Fi's and the network's work has
# left core 0: on the bench, turn usb-rt on with usb-cpu0 on first.
#
# Fails safe as far as it can: refused, with nothing changed, while sched_rt_runtime_us is -1
# (real-time limits lifted on purpose); a failed start is undone by ExecStopPost; stopped,
# ksoftirqd/0 goes back to SCHED_OTHER and an xHCI thread to FIFO 50 (the kernel's own values).
# Nothing is written to any file: a boot without the unit is the kernel's default. No restart, no
# reboot.
#
# Sandbox: CAP_SYS_NICE sets another thread's scheduling. No RestrictRealtime= (it would refuse
# the very call this unit makes).

[Unit]
Description=K1000 bench switch: real-time priority for the deferred USB work
Documentation=file:///opt/k1000/README.md

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/k1000/tools/k1000-cpu.py usb-rt apply
ExecStopPost=/usr/bin/python3 /opt/k1000/tools/k1000-cpu.py usb-rt undo
Environment=PYTHONDONTWRITEBYTECODE=1
SyslogIdentifier=k1000-usb-rt
CapabilityBoundingSet=CAP_SYS_NICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
