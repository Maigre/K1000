# SPDX-License-Identifier: GPL-3.0-or-later
# K1000 bench switch "usb-cpu0": core 0 left to the USB handling (D-023 point 3). Installed and
# enabled by box/install.sh --usb-cpu0-on, with the k1000 and camillagui usb-cpu0-*.conf drop-ins;
# stopped, disabled and removed by --usb-cpu0-off and by --cpu-off. Off by default. A 15 h run at
# 96 kHz held with no delay step in the state it builds (docs/17 §14).
#
# At boot it runs once k1000 and the engine have started (After=), so the boot itself runs on the
# processor settings' cores 0-1 (with systemd's default on core 1 from the start, the boot took 4 to
# 5 s longer to full level, 16 Nov), and the kernel threads that drivers start late (the HDMI and
# CEC ones) exist by then. Nothing waits for it.
#
# What it does when started (/opt/k1000/tools/k1000-cpu.py usb-cpu0 apply):
# - Every interrupt the kernel lets move goes to core 1 (/proc/irq/<n>/smp_affinity_list), and
#   interrupts set up later too (/proc/irq/default_smp_affinity). The SD card's and the Wi-Fi's
#   (one shared interrupt, "mmc0" and "mmc1", whose threads run at FIFO 50) matter most. Never the
#   xHCI's, the M4's USB host: the kernel cannot move it (an MSI behind the PCIe controller), and
#   it is why core 0 is left free. What the kernel refuses stays on core 0 and is reported.
# - The kernel's unbound workqueues leave core 0 (/sys/devices/virtual/workqueue/cpumask, cores
#   1-3): the Wi-Fi driver's receive work and the SD card's writeback run there. Cores 2-3 stay
#   open to them, as without the switch (the mask is every core by default): the engine's
#   real-time threads come before them, and core 1 alone would carry them with everything else.
# - Every user-space thread allowed on core 0 goes to core 1, except the engine's (its unit keeps
#   it on 2-3), systemd itself (PID 1) included, so what it starts from then on inherits core 1.
#   ExecStartPre puts /opt/k1000/cpu/usb-cpu0-system.conf in /run/systemd/system.conf.d/ so that a
#   later daemon-reload keeps core 1 (PID 1 reads that folder too); ExecStopPost removes it, and a
#   boot starts without it (/run is emptied at every boot).
# - Every kernel thread the kernel lets move goes to core 1 too (rcu_preempt, jbd2, kswapd0, the
#   interrupt threads); never kthreadd nor a per-core thread (docs/17 §14: both stalls traced on
#   the box began with core 0 running rcu_preempt's sleep time-out).
# It writes what it moved, kept and was refused to /run/k1000-usb-cpu0/report, which
# `k1000-cpu.py check` reads, with the cores each thread it moved had, which undo reads.
#
# Stopped, or after a failed start, ExecStopPost undoes it: interrupts and workqueues back on
# every core; each thread it moved back on the cores it had; the threads systemd started meanwhile
# on core 1 back on 0 and 1; a login session's commands keep their cores (a reader the bench
# pinned to core 1 keeps its pin). With the drop-ins removed (install.sh), a boot without the unit
# gives the same. No restart of any service and no reboot, either way. Like every install.sh run:
# never during a show.
#
# Why a unit and not irqaffinity=1 on the kernel command line: the same interrupts move either
# way, but this needs no edit of the boot files and no reboot, on or off, so the bench can switch
# it within one boot.
#
# Sandbox: CAP_SYS_NICE moves other users' threads; /proc/irq and /sys need root's own write
# permission only, so no ProtectKernelTunables (it would make them read-only).

[Unit]
Description=K1000 bench switch: core 0 left to the USB handling
Documentation=file:///opt/k1000/README.md
After=systemd-modules-load.service k1000.service camilladsp.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=+/usr/bin/install -D -m 0644 /opt/k1000/cpu/usb-cpu0-system.conf /run/systemd/system.conf.d/51-k1000-usb-cpu0.conf
ExecStart=/usr/bin/python3 /opt/k1000/tools/k1000-cpu.py usb-cpu0 apply
ExecStopPost=/usr/bin/python3 /opt/k1000/tools/k1000-cpu.py usb-cpu0 undo
ExecStopPost=+/usr/bin/rm -f /run/systemd/system.conf.d/51-k1000-usb-cpu0.conf
Environment=PYTHONDONTWRITEBYTECODE=1
SyslogIdentifier=k1000-usb-cpu0
RuntimeDirectory=k1000-usb-cpu0
RuntimeDirectoryMode=0755
UMask=0022
CapabilityBoundingSet=CAP_SYS_NICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
